# Compose only. Host applications load their own apps/*/.env files.
# Demo disables the RPC requirement; foundation has no scan/demo endpoints yet.
SCAN_MODE=demo
ETHEREUM_RPC_URL=
WEB_ORIGIN=http://localhost:3000
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=info
# Optional Compose host-port overrides; internal web/API ports stay 3000/3001.
WEB_HOST_PORT=3000
API_HOST_PORT=3001
